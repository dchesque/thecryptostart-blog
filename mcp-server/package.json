{
  "name": "@thecryptostart/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing thecryptostart.com blog API to MCP-capable clients (Claude Desktop, Claude Code, etc).",
  "type": "module",
  "bin": {
    "thecryptostart-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "vitest": "^2.1.5"
  }
}
