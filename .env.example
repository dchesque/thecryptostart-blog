# Database (Prisma + PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# NextAuth Configuration
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your_auth_secret

# Site Configuration
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console (GSC)
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Analytics & Ads
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# API Automation Key (used for external tools: n8n, Python scripts, AI agents)
# This key is validated in proxy.ts (middleware) via the X-API-Key header
# Generate: openssl rand -hex 32
ADMIN_API_KEY=your_admin_api_key_here

# Email — Resend (newsletter confirm/welcome, password reset)
# https://resend.com — free tier 3k/month
RESEND_API_KEY=re_your_key_here
NEWSLETTER_FROM=newsletter@yourdomain.com
NEWSLETTER_FROM_NAME="The Crypto Start"

# Rate limiting — Upstash Redis (optional; falls back to in-memory if missing)
# https://console.upstash.com — free tier 10k cmd/day
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Outbound webhooks — fired on selected blog events.
# Comma-separated list of URLs per event. Leave empty to disable.
# Each request is signed with X-Webhook-Signature: sha256=<hex> if WEBHOOK_SECRET is set.
#   PUBLISH_WEBHOOK_URLS    → post.published
#   UNPUBLISH_WEBHOOK_URLS  → post.unpublished
#   COMMENT_WEBHOOK_URLS    → comment.received + comment.moderated
PUBLISH_WEBHOOK_URLS=
UNPUBLISH_WEBHOOK_URLS=
COMMENT_WEBHOOK_URLS=
WEBHOOK_SECRET=

# Production & Deploy
# AUTH_TRUST_HOST=true
NODE_ENV=development
